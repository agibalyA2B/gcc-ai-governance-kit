{
  "name": "gcc-ai-governance-kit",
  "version": 1,
  "colors": {
    "primary": "#0F5257", "primary-dark": "#0A3B3F", "primary-tint": "#E6F0F0",
    "accent": "#C8A96A", "accent-text": "#8A6D32",
    "surface": "#FFFFFF", "surface-muted": "#F6F3EC", "surface-table-head": "#FBFAF7",
    "text": "#1B2426", "text-body": "#3D484A", "text-muted": "#5B6668",
    "border": "#E3DED3", "border-strong": "#C9C2B4",
    "tier-little": "#2E7D5B", "tier-limited": "#9A6412", "tier-high": "#C2410C", "tier-unacceptable": "#9F1239",
    "verified-bg": "#E3F3EB", "verified-text": "#1F5E43", "pending-bg": "#FBF0DC", "pending-text": "#7A4F0E",
    "alert-bg": "#FFF4EC", "alert-text": "#8A2D08"
  },
  "typography": {
    "display-latin": "Source Serif 4", "body-latin": "IBM Plex Sans",
    "display-arabic": "Noto Kufi Arabic", "body-arabic": "IBM Plex Sans Arabic",
    "scale": { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 24, "2xl": 30, "3xl": 46 },
    "line-height": { "latin": 1.55, "arabic": 1.75, "display": 1.1 },
    "eyebrow": { "size": 13, "weight": 600, "tracking": 1.4, "case": "uppercase" }
  },
  "spacing": { "unit": 4, "scale": [4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 80] },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 16, "pill": 999 },
  "shadow": { "card": "0 1px 2px rgb(15 82 87 / 0.06), 0 4px 16px rgb(15 82 87 / 0.06)" },
  "components": {
    "tier-badge": { "shape": "pill", "icon": { "little": "●", "limited": "◆", "high": "▲", "unacceptable": "■" }, "text": "#FFFFFF", "weight": 600 },
    "verification-badge": { "verified": "✓ on verified-bg", "pending": "⏱ on pending-bg" },
    "chip": { "radius": "pill", "selected": "border primary, bg primary-tint", "unselected": "border #D8D2C4, bg surface" },
    "stepper": { "current": "primary fill, white text", "done": "✓ in tier-little", "todo": "number in primary" },
    "brand-mark": "two overlapping 16px squares (one rotated 45°) with a 3px circle, stroke accent 1.6"
  },
  "source": "Design canvas: GCC AI Governance Kit — UI design (5 artboards: Register EN/AR, Tier, Controls, Committee report A4)."
}
