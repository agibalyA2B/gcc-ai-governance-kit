{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Control crosswalk",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "theme", "title_en", "title_ar", "control_text_en", "control_text_ar", "applies_when", "refs", "source_urls", "verified", "verified_on", "notes"],
    "properties": {
      "id": { "type": "string", "pattern": "^CTL-[A-Z]{2,4}-[0-9]{2}$" },
      "theme": { "enum": ["accountability", "transparency", "data", "human-oversight", "safety-security", "monitoring"] },
      "title_en": { "type": "string", "minLength": 3 },
      "title_ar": { "type": "string", "minLength": 3 },
      "control_text_en": { "type": "string", "minLength": 10 },
      "control_text_ar": { "type": "string", "minLength": 10 },
      "applies_when": {
        "type": "object", "additionalProperties": false, "required": ["min_tier"],
        "properties": {
          "min_tier": { "enum": ["little", "limited", "high"] },
          "ai_types": { "type": "array", "items": { "enum": ["predictive", "generative", "agentic"] } },
          "data": { "type": "array", "items": { "enum": ["personal", "sensitive"] } }
        }
      },
      "refs": {
        "type": "object", "additionalProperties": false,
        "required": ["uae_charter", "dubai_ethics", "sdaia", "iso42001", "nist_ai_rmf", "eu_ai_act"],
        "properties": {
          "uae_charter": { "type": "array", "items": { "type": "string" } },
          "dubai_ethics": { "type": "array", "items": { "type": "string" } },
          "sdaia": { "type": "array", "items": { "type": "string" } },
          "iso42001": { "type": "array", "items": { "type": "string", "pattern": "^(A\\.)?[0-9]+(\\.[0-9]+)*$" } },
          "nist_ai_rmf": { "type": "array", "items": { "type": "string", "pattern": "^(GOVERN|MAP|MEASURE|MANAGE) [0-9]+(\\.[0-9]+)?$" } },
          "eu_ai_act": { "type": "array", "items": { "type": "string" } }
        }
      },
      "source_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
      "verified": { "type": "boolean" },
      "verified_on": { "type": ["string", "null"] },
      "notes": { "type": "string" }
    },
    "if": { "properties": { "verified": { "const": true } } },
    "then": { "properties": { "source_urls": { "minItems": 1 }, "verified_on": { "type": "string" } } }
  }
}
