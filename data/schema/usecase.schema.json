{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI use-case register export",
  "type": "object",
  "required": [
    "format",
    "version",
    "useCases"
  ],
  "properties": {
    "format": {
      "const": "gcc-ai-governance-kit/register"
    },
    "version": {
      "const": 1
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "owner",
          "answers",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "businessUnit": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "enum": [
              "idea",
              "pilot",
              "production",
              "retired"
            ]
          },
          "notes": {
            "type": "string"
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "description": "Control-evidence map keyed by control id (optional; added in 0.3.0).",
            "propertyNames": {
              "pattern": "^CTL-[A-Z]{2,4}-[0-9]{2}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "status",
                "note"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "",
                    "met",
                    "partly",
                    "gap",
                    "na"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            }
          },
          "product": {
            "type": "string",
            "maxLength": 200,
            "description": "Per-deployment profiles: product this use case is a deployment of (optional; 0.3.1)."
          },
          "deployment": {
            "type": "string",
            "maxLength": 200,
            "description": "Label for this deployment, e.g. Internal, SaaS, Agent (optional; 0.3.1)."
          },
          "actions": {
            "type": "object",
            "description": "Action matrix: per-action settings, never looser than the kit's ceiling (optional; 0.4, ADR 014).",
            "additionalProperties": {
              "$ref": "#/definitions/actionSetting"
            },
            "propertyNames": {
              "enum": [
                "classify",
                "recommend",
                "draft",
                "update",
                "communicate",
                "decide"
              ]
            }
          },
          "releaseStage": {
            "enum": [
              "pre-pilot",
              "replay",
              "shadow",
              "assisted",
              "bounded",
              "expansion"
            ],
            "description": "Release stage on the autonomy ladder (optional; 0.4, ADR 016)."
          },
          "stageDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date the release stage was last set (optional; 0.4)."
          },
          "euExposure": {
            "enum": [
              "no",
              "unsure",
              "yes"
            ],
            "description": "Optional EU exposure; links to the EN 18286 note and never changes the tier (0.4, ADR 017)."
          }
        }
      }
    },
    "kitVersion": {
      "type": "string",
      "description": "Version of the kit that wrote the file (optional; 0.4)."
    },
    "exportedAt": {
      "type": "string",
      "description": "When the file was written, ISO 8601 (optional; 0.4)."
    }
  },
  "definitions": {
    "actionSetting": {
      "type": "object",
      "properties": {
        "permission": {
          "enum": [
            "allowed",
            "approval",
            "blocked"
          ]
        },
        "limits": {
          "type": "string",
          "maxLength": 500
        },
        "reversible": {
          "enum": [
            "",
            "yes",
            "no"
          ]
        },
        "approver": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    }
  }
}
