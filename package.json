{
  "name": "gcc-ai-governance-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Open, bilingual (AR/EN) AI-governance starter kit for GCC organisations.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-templates.mjs && tsc --noEmit && vite build",
    "build:templates": "node scripts/build-templates.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "media:guide": "playwright test -c scripts/media/playwright.media.config.ts guide-shots && playwright test -c scripts/media/playwright.media.config.ts guide-pdf"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
